<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MangaGui.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="MangaGui.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Manga GUI"
        Width="1280" Height="800"
        MinWidth="950" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#000000">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- CRUNCHYROLL TOP NAVIGATION BAR -->
        <Border Grid.Row="0" Background="#000000" BorderBrush="#1C1C1E" BorderThickness="0,0,0,1" Padding="30,12">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <!-- Crunchyroll Logo & Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Cursor="Hand">
                    <!-- Crunchyroll Orange Eye Icon -->
                    <Path Data="M 12 2 C 6.48 2 2 6.48 2 12 C 2 17.52 6.48 22 12 22 C 17.52 22 22 17.52 22 12 C 22 6.48 17.52 2 12 2 Z M 12 6 C 15.31 6 18 8.69 18 12 C 18 15.31 15.31 18 12 18 C 8.69 18 6 15.31 6 12 C 6 8.69 8.69 6 12 6 Z"
                          Fill="#FF640A" Width="26" Height="26" Stretch="Uniform" VerticalAlignment="Center"/>
                    <TextBlock Text="manga gui" FontWeight="Black" FontSize="22" Foreground="#FF640A" VerticalAlignment="Center" LetterSpacing="-0.5"/>
                </StackPanel>

                <!-- Navigation Links -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="24" Margin="35,0,0,0" VerticalAlignment="Center">
                    <Button Content="Anime" 
                            Command="{Binding SwitchTabCommand}" 
                            CommandParameter="Anime"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{Binding AnimeTabColor}"
                            Cursor="Hand" />

                    <Button Content="Manga" 
                            Command="{Binding SwitchTabCommand}" 
                            CommandParameter="Manga"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{Binding MangaTabColor}"
                            Cursor="Hand" />

                    <Button Content="Popolari" 
                            Command="{Binding LoadCatalogCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#A0A0A0"
                            Cursor="Hand" />

                    <Button Content="Simulcast" 
                            Command="{Binding LoadCatalogCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#A0A0A0"
                            Cursor="Hand" />

                    <!-- Source Selector -->
                    <ComboBox ItemsSource="{Binding Sources}" 
                              SelectedItem="{Binding SelectedSource}"
                              CornerRadius="4"
                              Background="#141519"
                              BorderBrush="#2B2C30"
                              Foreground="#FFFFFF"
                              FontSize="12"
                              Width="140"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right Tools (Search, Premium, Bookmark, User) -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                    <!-- Search Input Box -->
                    <Border Background="#141519" BorderBrush="#2B2C30" BorderThickness="1" CornerRadius="20" Padding="12,6" Width="240">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" 
                                     Text="{Binding SearchQuery}" 
                                     PlaceholderText="Cerca anime, manga..." 
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     FontSize="13"
                                     Foreground="#FFFFFF">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                            <Button Grid.Column="1" 
                                    Command="{Binding SearchCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="4,0"
                                    Content="🔍" 
                                    Cursor="Hand" />
                        </Grid>
                    </Border>



                    <!-- Watched Manga / Anime History Button -->
                    <Button Command="{Binding ShowHistoryCommand}"
                            Background="#18191E"
                            BorderBrush="#2C2D35"
                            BorderThickness="1"
                            CornerRadius="20"
                            Padding="12,6"
                            Cursor="Hand"
                            ToolTip.Tip="Manga e Anime Guardati (Cronologia)">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Path Data="M 12 2 C 6.48 2 2 6.48 2 12 C 2 17.52 6.48 22 12 22 C 17.52 22 22 17.52 22 12 C 22 6.48 17.52 2 12 2 Z M 12 4 C 16.42 4 20 7.58 20 12 C 20 16.42 16.42 20 12 20 C 7.58 20 4 16.42 4 12 C 4 7.58 7.58 4 12 4 Z M 12.5 7 L 11 7 L 11 13 L 16.2 16.2 L 17 14.9 L 12.5 12.2 Z"
                                  Fill="#FF640A"
                                  Width="16"
                                  Height="16"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="Guardati"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN BODY -->
        <Grid Grid.Row="1">
            <!-- Loading Indicator -->
            <ProgressBar IsIndeterminate="True" 
                         IsVisible="{Binding IsLoading}" 
                         Height="2" 
                         VerticalAlignment="Top" 
                         Foreground="#FF640A"/>

            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="40,25">
                <StackPanel Spacing="16">
                    <!-- PAGE HEADER (MOST POPULAR ANIME + FILTER) -->
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" 
                                   Text="{Binding PageHeaderTitle}" 
                                   FontSize="28" 
                                   FontWeight="Bold" 
                                   Foreground="#FFFFFF"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                            <TextBlock Text="≡ POPULARITY" FontSize="12" FontWeight="Bold" Foreground="#A0A0A0" VerticalAlignment="Center" Cursor="Hand"/>
                            <TextBlock Text="⎇ FILTER" FontSize="12" FontWeight="Bold" Foreground="#A0A0A0" VerticalAlignment="Center" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>

                    <!-- SUB-HEADER CATEGORY -->
                    <TextBlock Text="{Binding PageSubHeader}" FontSize="16" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,10,0,8"/>

                    <!-- VERTICAL POSTER CARDS GRID (EXACT CRUNCHYROLL STYLE) -->
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding ((vm:MainViewModel)DataContext).SelectItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Margin="0,0,24,28"
                                        Cursor="Hand">
                                    <StackPanel Width="175">
                                        <!-- Vertical Poster Image Container -->
                                        <Border Width="175" 
                                                Height="255" 
                                                CornerRadius="4" 
                                                Background="#141519" 
                                                ClipToBounds="True">
                                            <Grid>
                                                <!-- Cover Image from Web -->
                                                <Image loader:ImageLoader.Source="{Binding Image}" 
                                                       Stretch="UniformToFill" 
                                                       IsVisible="{Binding HasImage}" />

                                                <!-- Fallback placeholder if no image -->
                                                <Grid IsVisible="{Binding !HasImage}" Background="#1E1F26">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                                                        <TextBlock Text="{Binding TypeIcon}" FontSize="32" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Title}" 
                                                                   FontSize="11" 
                                                                   FontWeight="Bold"
                                                                   Foreground="#A0A0A0" 
                                                                   TextWrapping="Wrap" 
                                                                   TextAlignment="Center"
                                                                   Margin="8,0"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Top-Right Crunchyroll Orange Bookmark Ribbon (Vector notched flag, no emoji) -->
                                                <Path Data="M 0 0 L 14 0 L 14 20 L 7 15 L 0 20 Z" 
                                                      Fill="#FF640A" 
                                                      Width="14" 
                                                      Height="20" 
                                                      Stretch="Fill" 
                                                      HorizontalAlignment="Right" 
                                                      VerticalAlignment="Top"
                                                      Margin="0,0,10,0"/>

                                                <!-- Bottom Source Pill Overlay -->
                                                <Border HorizontalAlignment="Left" 
                                                        VerticalAlignment="Bottom" 
                                                        Background="#B3000000" 
                                                        CornerRadius="0,6,0,0"
                                                        Padding="6,2">
                                                    <TextBlock Text="{Binding SourceLabel}" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Anime / Manga Title Below Poster -->
                                        <TextBlock Text="{Binding Title}" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="13" 
                                                   Foreground="#FFFFFF" 
                                                   TextWrapping="Wrap" 
                                                   MaxLines="2"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,8,0,3"/>

                                        <!-- Subtitle: Sub | Dub (Exact Crunchyroll caption) -->
                                        <TextBlock Text="{Binding SubDubText}" 
                                                   FontSize="12" 
                                                   Foreground="#A0A0A0"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- CRUNCHYROLL DETAIL POPUP / MODAL (WHEN A CARD IS CLICKED) -->
            <Border Background="#EB000000" 
                    VerticalAlignment="Bottom"
                    BorderBrush="#252528"
                    BorderThickness="0,1,0,0"
                    Padding="35,22"
                    IsVisible="{Binding SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Left: Poster Thumbnail -->
                    <Border Grid.Column="0" Width="70" Height="100" CornerRadius="4" ClipToBounds="True" Background="#141519" Margin="0,0,20,0">
                        <Image loader:ImageLoader.Source="{Binding SelectedItem.Image}" Stretch="UniformToFill"/>
                    </Border>

                    <!-- Middle: Title & Metadata -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding SelectedItem.Title}" FontWeight="Black" FontSize="20" Foreground="#FFFFFF"/>
                            <Border CornerRadius="4" Padding="6,2" Background="#FF640A" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedItem.AudioBadge}" FontSize="10" FontWeight="Black" Foreground="#000000"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedItem.SubDubText}" FontSize="13" Foreground="#FF640A" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SelectedItem.SourceLabel, StringFormat='Fonte provider: {0}'}" FontSize="12" Foreground="#808080"/>
                    </StackPanel>

                    <!-- Right: Episode/Chapter Picker & Crunchyroll Orange Action Button -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{Binding NumberLabel}" Foreground="#A0A0A0" FontSize="13" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <NumericUpDown Value="{Binding SelectedNumber}" 
                                               Minimum="1" 
                                               Maximum="{Binding MaxNumber}" 
                                               Width="95" 
                                               CornerRadius="4"
                                               Background="#141519"
                                               BorderBrush="#333333"
                                               Foreground="#FFFFFF"/>
                                <TextBlock Text="{Binding MaxNumber, StringFormat='di {0}'}" 
                                           Foreground="#A0A0A0" 
                                           FontSize="12" 
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Watched Badge & Unmark Button -->
                        <Border Background="#201005"
                                BorderBrush="#FF640A"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,6"
                                VerticalAlignment="Center"
                                IsVisible="{Binding IsCurrentNumberWatched}">
                            <TextBlock Text="{Binding WatchedStatusBadge}" Foreground="#FF640A" FontWeight="Bold" FontSize="11"/>
                        </Border>

                        <Button Command="{Binding UnmarkCurrentNumberCommand}"
                                ToolTip.Tip="Deseleziona questo episodio/capitolo dalla cronologia"
                                Padding="12,10"
                                CornerRadius="4"
                                Background="#2A1B1B"
                                BorderBrush="#E53935"
                                BorderThickness="1"
                                Foreground="#FF7070"
                                Cursor="Hand"
                                IsVisible="{Binding IsCurrentNumberWatched}">
                            <TextBlock Text="{Binding UnmarkButtonText}" FontSize="12" FontWeight="SemiBold"/>
                        </Button>

                        <!-- Big Crunchyroll Orange Play Button -->
                        <Button Command="{Binding PlayOrReadCommand}" 
                                Padding="26,12" 
                                CornerRadius="4" 
                                Background="#FF640A"
                                Foreground="#000000"
                                FontWeight="Black"
                                Cursor="Hand">
                            <TextBlock Text="{Binding ActionButtonText}" FontSize="13" FontWeight="Black" Foreground="#000000"/>
                        </Button>

                        <!-- Remove Entire Title from History -->
                        <Button Command="{Binding RemoveItemFromHistoryCommand}" 
                                ToolTip.Tip="Rimuovi l'intera opera dalla cronologia"
                                Background="#1F1F23" 
                                Foreground="#808080"
                                CornerRadius="4" 
                                Padding="12,10"
                                Cursor="Hand"
                                Content="🗑"/>

                        <Button Command="{Binding CloseDetailsCommand}" 
                                Content="✕" 
                                Background="#1F1F23" 
                                Foreground="#A0A0A0"
                                CornerRadius="4" 
                                Padding="12,10"
                                Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- CRUNCHYROLL BOTTOM STATUS BAR -->
        <Border Grid.Row="2" Background="#0A0A0C" BorderBrush="#1C1C1E" BorderThickness="0,1,0,0" Padding="30,8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="#808080" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="manga-gui v1.0.0" Foreground="#505050" FontSize="12" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
